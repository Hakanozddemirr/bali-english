  "scenario": {
    "title": "Eczanede",
    "role": "a helpful pharmacist at an apotek (pharmacy) in Bali",
    "firstLine": "Hello. Can I help you?",
    "situationTr": "Miden bozuldu ve hafif ateşin var. Eczaneye (apotek) ilaç almaya gittin.",
    "goalTr": "Şikayetini anlat (mide, ateş), ilaç iste ve nasıl kullanacağını sor.",
    "script": [
      {
        "ai": "Hello. Can I help you?",
        "tr": "Merhaba. Yardımcı olabilir miyim?",
        "expect": [
          "sick",
          "help",
          "yes"
        ],
        "say": "Yes, I'm sick."
      },
      {
        "ai": "Oh no. What is the problem?",
        "tr": "Geçmiş olsun. Sorununuz nedir?",
        "expect": [
          "stomach",
          "hurt"
        ],
        "say": "My stomach hurts."
      },
      {
        "ai": "Do you have a fever too?",
        "tr": "Ateşiniz de var mı?",
        "expect": [
          "yes",
          "little",
          "fever",
          "no"
        ],
        "say": "Yes, a little fever."
      },
      {
        "ai": "Okay. This medicine is good for your stomach.",
        "tr": "Tamam. Bu ilaç mideniz için iyi.",
        "expect": [
          "how",
          "take",
          "when"
        ],
        "say": "How do I take it?"
      },
      {
        "ai": "Two times a day, after food.",
        "tr": "Günde iki kez, yemekten sonra.",
        "expect": [
          "okay",
          "thank",
          "how much"
        ],
        "say": "Okay, thank you. How much is it?"
      },
      {
        "ai": "40,000 rupiah, please.",
        "tr": "40.000 rupiah lütfen.",
        "expect": [
          "here",
          "card",
          "you are"
        ],
        "say": "Here you are."
      },
      {
        "ai": "Thank you. Do you need anything else? Mosquito spray?",
        "tr": "Teşekkürler. Başka bir şey lazım mı? Sivrisinek spreyi?",
        "expect": [
          "mosquito",
          "yes",
          "spray",
          "please"
        ],
        "say": "Yes, mosquito spray, please."
      },
      {
        "ai": "Here. Use it in the evening.",
        "tr": "Buyurun. Akşamları kullanın.",
        "expect": [
          "okay",
          "thank",
          "evening"
        ],
        "say": "Okay, thank you."
      },
      {
        "ai": "And drink a lot of water, okay?",
        "tr": "Ve bol su için, tamam mı?",
        "expect": [
          "okay",
          "yes",
          "i will",
          "water"
        ],
        "say": "Okay, I will."
      },
      {
        "ai": "If the fever is big tomorrow, go to a doctor.",
        "tr": "Yarın ateşiniz yükselirse doktora gidin.",
        "expect": [
          "okay",
          "doctor",
          "i will",
          "go"
        ],
        "say": "Okay, I will go to a doctor."
      },
      {
        "ai": "And no beer today, my friend!",
        "tr": "Ve bugün bira yok dostum!",
        "expect": [
          "okay",
          "no beer",
          "haha"
        ],
        "say": "Okay, no beer today!"
      },
      {
        "ai": "Get well soon! Goodbye!",
        "tr": "Geçmiş olsun! İyi günler!",
        "expect": [
          "thank",
          "goodbye",
          "bye"
        ],
        "say": "Thank you! Goodbye!"
      }
