    "role": "a helpful pharmacist at an apotek (pharmacy) in Bali",
    "firstLine": "Hello. Can I help you?",
    "situationTr": "Miden bozuldu ve hafif ateşin var. Eczaneye (apotek) ilaç almaya gittin.",
    "goalTr": "Şikayetini anlat (mide, ateş), ilaç iste ve nasıl kullanacağını sor.",
    "script": [
      { "ai": "Hello. Can I help you?", "tr": "Merhaba. Yardımcı olabilir miyim?", "expect": ["sick", "help", "medicine", "yes"], "say": "Yes, I'm sick." },
      { "ai": "Oh no. What is the problem?", "tr": "Geçmiş olsun. Sorununuz nedir?", "expect": ["stomach", "hurt"], "say": "My stomach hurts." },
      { "ai": "Do you have a fever too?", "tr": "Ateşiniz de var mı?", "expect": ["yes", "little", "fever", "no"], "say": "Yes, a little fever." },
      { "ai": "Okay. This medicine is good for your stomach.", "tr": "Tamam. Bu ilaç mideniz için iyi.", "expect": ["how", "take", "when"], "say": "How do I take it?" },
      { "ai": "Two times a day, after food.", "tr": "Günde iki kez, yemekten sonra.", "expect": ["okay", "thank", "how much"], "say": "Okay, thank you. How much is it?" },
      { "ai": "40,000 rupiah, please.", "tr": "40.000 rupiah lütfen.", "expect": ["here", "card", "okay", "you are"], "say": "Here you are." },
      { "ai": "Thank you. Drink a lot of water, okay?", "tr": "Teşekkürler. Bol su için, tamam mı?", "expect": ["okay", "yes", "thank", "i will"], "say": "Okay, I will. Thank you!" },
      { "ai": "Get well soon! Goodbye!", "tr": "Geçmiş olsun! İyi günler!", "expect": ["thank", "goodbye", "bye"], "say": "Thank you! Goodbye!" }
    ]
  },
