  "scenario": {
    "title": "Tanışma",
    "role": "a friendly Australian traveler relaxing by the hotel pool in Bali",
    "firstLine": "Hello! What's your name?",
    "situationTr": "Otelin havuz başındasın. Yan şezlongdaki gezgin seninle sohbet başlatıyor.",
    "goalTr": "Selamlaş, adını söyle, nasıl olduğunu söyle ve karşındakine de sor.",
    "script": [
      {
        "ai": "Hello! What's your name?",
        "tr": "Merhaba! Senin adın ne?",
        "expect": [
          "my name",
          "i am",
          "i'm",
          "hakan"
        ],
        "say": "My name is Hakan."
      },
      {
        "ai": "Nice to meet you! How are you?",
        "tr": "Memnun oldum! Nasılsın?",
        "expect": [
          "fine",
          "good",
          "great",
          "okay",
          "not bad"
        ],
        "say": "I'm fine, thank you."
      },
      {
        "ai": "I'm happy you are fine! Where are you from?",
        "tr": "İyi olmana sevindim! Nerelisin?",
        "expect": [
          "turkey",
          "from"
        ],
        "say": "I'm from Turkey."
      },
      {
        "ai": "Turkey! Very nice. Is this your first time in Bali?",
        "tr": "Türkiye! Çok güzel. Bali'ye ilk gelişin mi?",
        "expect": [
          "yes",
          "first",
          "no"
        ],
        "say": "Yes, it's my first time."
      },
      {
        "ai": "Welcome! Do you want some water?",
        "tr": "Hoş geldin! Su ister misin?",
        "expect": [
          "yes",
          "please",
          "no thank"
        ],
        "say": "Yes, please."
      },
      {
        "ai": "Here you are! How many days are you in Bali?",
        "tr": "Buyur! Bali'de kaç gün kalacaksın?",
        "expect": [
          "ten",
          "day",
          "week"
        ],
        "say": "Ten days."
      },
      {
        "ai": "Ten days, perfect! The pool is very nice today.",
        "tr": "On gün, harika! Havuz bugün çok güzel.",
        "expect": [
          "yes",
          "nice",
          "beautiful",
          "very"
        ],
        "say": "Yes, very nice!"
      },
      {
        "ai": "I will swim now. See you later!",
        "tr": "Ben yüzmeye gidiyorum. Sonra görüşürüz!",
        "expect": [
          "see you",
          "later",
          "bye"
        ],
        "say": "See you later!"
      },
      {
        "ai": "(Later) Hello again! The water is great!",
        "tr": "(Daha sonra) Yine merhaba! Su harika!",
        "expect": [
          "hello",
          "hi",
          "again"
        ],
        "say": "Hello again!"
      },
      {
        "ai": "Are you here with your family?",
        "tr": "Ailenle mi buradasın?",
        "expect": [
          "no",
          "friend",
          "yes",
          "alone",
          "family"
        ],
        "say": "No, I'm here with a friend."
      },
      {
        "ai": "Nice! What's your friend's name?",
        "tr": "Güzel! Arkadaşının adı ne?",
        "expect": [
          "name is",
          "his",
          "her"
        ],
        "say": "His name is Ali."
      },
      {
        "ai": "Do you want a fresh coconut? It's free at the pool!",
        "tr": "Taze hindistan cevizi ister misin? Havuzda ücretsiz!",
        "expect": [
          "yes",
          "please",
          "thank"
        ],
        "say": "Yes, please. Thank you!"
      },
      {
        "ai": "Here you are! Do you like the water?",
        "tr": "Buyur! Suyu sevdin mi?",
        "expect": [
          "yes",
          "like",
          "love",
          "very"
        ],
        "say": "Yes, I like it very much."
      },
      {
        "ai": "Me too! Tonight there is music at the bar. Will you come?",
        "tr": "Ben de! Bu akşam barda müzik var. Gelir misin?",
        "expect": [
          "yes",
          "okay",
          "see you",
          "come"
        ],
        "say": "Yes! See you tonight!"
      },
      {
        "ai": "Great! It starts at eight. Goodbye!",
        "tr": "Harika! Sekizde başlıyor. Görüşürüz!",
        "expect": [
          "eight",
          "okay",
          "goodbye",
          "see you"
        ],
        "say": "Okay, at eight. Goodbye!"
      }
    ]
