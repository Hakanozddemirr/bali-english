        "tr": "Haha! Buyurun tatlınız. Afiyet olsun!",
        "expect": [
          "thank"
        ],
        "say": "Thank you!"
      },
      {
        "ai": "Was everything good today?",
        "tr": "Bugün her şey güzel miydi?",
