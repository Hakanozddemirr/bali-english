  "scenario": {
    "title": "Otele Giriş",
    "role": "a friendly hotel receptionist in Ubud, Bali",
    "firstLine": "Good afternoon! Welcome. Do you have a reservation?",
    "situationTr": "Oteline vardın. Resepsiyonda check-in yapıyorsun.",
    "goalTr": "Rezervasyonun olduğunu söyle, kahvaltı saatini ve wifi şifresini sor.",
    "script": [
      {
        "ai": "Good afternoon! Welcome. Do you have a reservation?",
        "tr": "İyi günler! Hoş geldiniz. Rezervasyonunuz var mı?",
        "expect": [
          "yes",
          "reservation",
          "have"
        ],
        "say": "Yes, I have a reservation."
      },
      {
        "ai": "What is your name, please?",
        "tr": "İsminiz lütfen?",
        "expect": [
          "my name",
          "hakan",
          "i am",
          "i'm"
        ],
        "say": "My name is Hakan."
      },
      {
        "ai": "Ah yes — ten nights. Your passport, please.",
        "tr": "Evet — on gece. Pasaportunuz lütfen.",
        "expect": [
          "here",
          "passport"
        ],
        "say": "Here you are."
      },
      {
        "ai": "Thank you. Your room is number seven.",
        "tr": "Teşekkürler. Odanız yedi numara.",
        "expect": [
          "thank",
          "seven",
          "okay"
        ],
        "say": "Thank you."
      },
      {
        "ai": "Do you have any questions?",
        "tr": "Sorunuz var mı?",
        "expect": [
          "wifi",
          "password",
          "yes"
        ],
        "say": "Yes — what is the wifi password?"
      },
      {
        "ai": "The wifi password is BALI2026.",
        "tr": "Wifi şifresi: BALI2026.",
        "expect": [
          "thank",
          "breakfast",
          "what time"
        ],
        "say": "Thank you. What time is breakfast?"
      },
      {
        "ai": "Breakfast is at eight, near the pool.",
        "tr": "Kahvaltı saat sekizde, havuzun yanında.",
        "expect": [
          "thank",
          "okay",
          "great"
        ],
        "say": "Thank you very much!"
      },
      {
        "ai": "Here is your key. Enjoy your stay!",
        "tr": "İşte anahtarınız. İyi konaklamalar!",
        "expect": [
          "thank",
          "goodbye"
        ],
        "say": "Thank you! Goodbye."
      },
      {
        "ai": "(The room phone rings) Hello, reception here. Is everything okay with your room?",
        "tr": "(Oda telefonu çalıyor) Merhaba, resepsiyon. Odanızda her şey yolunda mı?",
        "expect": [
          "no",
          "broken",
          "air",
          "problem"
        ],
        "say": "No — the air conditioning is broken."
      },
      {
        "ai": "Oh, sorry! We will send someone now. Anything else?",
        "tr": "Kusura bakmayın! Hemen birini gönderiyoruz. Başka bir şey?",
        "expect": [
          "towel",
          "yes",
          "please"
        ],
        "say": "Yes, a towel, please."
      },
      {
        "ai": "Of course, two towels. Is the wifi working?",
        "tr": "Tabii, iki havlu. Wifi çalışıyor mu?",
        "expect": [
          "yes",
          "working",
          "no"
        ],
        "say": "Yes, the wifi is working."
      },
      {
        "ai": "Good! The pool is open until ten tonight.",
        "tr": "Güzel! Havuz bu akşam ona kadar açık.",
        "expect": [
          "thank",
          "okay",
          "ten"
        ],
        "say": "Thank you!"
      },
      {
        "ai": "Do you want a taxi for tomorrow?",
        "tr": "Yarın için taksi ister misiniz?",
        "expect": [
          "yes",
          "morning",
          "please"
        ],
        "say": "Yes, for tomorrow morning, please."
      },
      {
        "ai": "What time?",
        "tr": "Saat kaçta?",
        "expect": [
          "nine",
          "at"
        ],
        "say": "At nine, please. Thank you!"
      }
    ]
  },
