      { "ai": "Do you have any questions?", "tr": "Sorunuz var mı?", "expect": ["wifi", "password", "yes"], "say": "Yes — what is the wifi password?" },
      { "ai": "The wifi password is BALI2026.", "tr": "Wifi şifresi: BALI2026.", "expect": ["thank", "breakfast", "what time"], "say": "Thank you. What time is breakfast?" },
      { "ai": "Breakfast is at eight, near the pool.", "tr": "Kahvaltı saat sekizde, havuzun yanında.", "expect": ["thank", "okay", "great"], "say": "Thank you very much!" },
      { "ai": "Here is your key. Enjoy your stay!", "tr": "İşte anahtarınız. İyi konaklamalar!", "expect": ["thank", "goodbye"], "say": "Thank you! Goodbye." }
    ]
