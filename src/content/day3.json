    "situationTr": "Oteline vardın. Resepsiyonda check-in yapıyorsun.",
    "goalTr": "Rezervasyonun olduğunu söyle, kahvaltı saatini ve wifi şifresini sor.",
    "script": [
      { "ai": "Good afternoon! Welcome. Do you have a reservation?", "tr": "İyi günler! Hoş geldiniz. Rezervasyonunuz var mı?", "expect": ["yes", "reservation", "have"], "say": "Yes, I have a reservation." },
